EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_WEB_URL=https://your-autopr-web.example.com
# Exact HTTPS origin used by signed attachment download URLs.
EXPO_PUBLIC_ATTACHMENT_ORIGIN=https://your-bucket.your-account-id.r2.cloudflarestorage.com
# Comma-separated extra hosts whose in-chat images may auto-load (exact host,
# or suffix with a leading dot). Example: files.example.com,.proxy.daytona.example.com
EXPO_PUBLIC_TRUSTED_FILE_HOSTS=
