# Convex / Clerk - required by the web app
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Daytona - required by the sandbox agent
DAYTONA_API_KEY=

# Optional Daytona configuration
# DAYTONA_API_URL=
# DAYTONA_SNAPSHOT=daytonaio/sandbox:0.6.0
# DAYTONA_SANDBOX_ID=

# Optional repo bootstrap inside the sandbox.
# If set, the agent clones this repo into the sandbox workdir at ./repo.
# DAYTONA_REPO_URL=https://github.com/your-org/your-repo.git
# DAYTONA_REPO_BRANCH=main
