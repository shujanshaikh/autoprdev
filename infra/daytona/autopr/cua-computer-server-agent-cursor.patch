+                # command open for one extra frame so a following action cannot
+                # preempt the visible approach animation.
+                await asyncio.sleep(0.52)
+            return None
+        except Exception as error:
+            return str(error)
+
+    async def probe_agent_cursor(self) -> Dict[str, Any]:
+        """Prove the official overlay changes pixels in a desktop capture."""
+
+        try:
+            from PIL import ImageGrab
+
+            await self._ensure_session()
+            x, y = await self._point(None, None)
+            size = await self.get_screen_size()
+            if not size.get("success"):
+                raise RuntimeError(size.get("error", "Screen size is unavailable"))
+            width = int(size["size"]["width"])
+            height = int(size["size"]["height"])
+            left = max(0, x - 96)
+            top = max(0, y - 96)
+            right = min(width, x + 128)
+            bottom = min(height, y + 128)
+            box = (left, top, right, bottom)
+
+            # Shape/mapping metadata was previously treated as proof of paint,
+            # but it cannot prove that an X11 screen grab (and therefore
+            # Daytona's recorder) receives the window's pixels. Compare two
+            # visible frames against stable hidden frames on both sides so
+            # unrelated video, caret, or application animation is rejected.
+            await self._driver.set_agent_cursor_enabled(
+                self._sdk.SetAgentCursorEnabledInput(
+                    session=self._session_id,
+                    enabled=False,
+                )
+            )
+            try:
+                cursor_sync_error = await self._sync_agent_cursor_position(
+                    x, y, wait_for_glide=True
+                )
+                if cursor_sync_error:
+                    raise RuntimeError(cursor_sync_error)
+                await asyncio.sleep(0.08)
+                hidden_before = await asyncio.to_thread(ImageGrab.grab, bbox=box)
+                await self._driver.set_agent_cursor_enabled(
+                    self._sdk.SetAgentCursorEnabledInput(
+                        session=self._session_id,
+                        enabled=True,
+                    )
+                )
+                await asyncio.sleep(0.08)
+                visible_first = await asyncio.to_thread(ImageGrab.grab, bbox=box)
+                await asyncio.sleep(0.04)
+                visible_second = await asyncio.to_thread(ImageGrab.grab, bbox=box)
+                await self._driver.set_agent_cursor_enabled(
+                    self._sdk.SetAgentCursorEnabledInput(
+                        session=self._session_id,
+                        enabled=False,
+                    )
+                )
+                await asyncio.sleep(0.08)
+                hidden_after = await asyncio.to_thread(ImageGrab.grab, bbox=box)
+            finally:
+                # Never leave automation without a pointer if the capture
+                # probe itself fails (for example during an X server restart).
+                await self._driver.set_agent_cursor_enabled(
+                    self._sdk.SetAgentCursorEnabledInput(
+                        session=self._session_id,
+                        enabled=True,
+                    )
+                )
+            rgb_frames = [
+                frame.convert("RGB")
+                for frame in (hidden_before, visible_first, visible_second, hidden_after)
+            ]
+            pixel_frames = [
+                frame.get_flattened_data()
+                if hasattr(frame, "get_flattened_data")
+                else frame.getdata()
+                for frame in rgb_frames
+            ]
+            changed_pixels = 0
+            unstable_pixels = 0
+            for hidden_a, visible_a, visible_b, hidden_b in zip(*pixel_frames):
+                hidden_delta = max(abs(left - right) for left, right in zip(hidden_a, hidden_b))
+                if hidden_delta > 6:
+                    unstable_pixels += 1
+                    continue
+                visible_delta = min(
+                    max(abs(left - right) for left, right in zip(visible_a, hidden_a)),
+                    max(abs(left - right) for left, right in zip(visible_a, hidden_b)),
+                    max(abs(left - right) for left, right in zip(visible_b, hidden_a)),
+                    max(abs(left - right) for left, right in zip(visible_b, hidden_b)),
+                )
+                if visible_delta >= 12:
+                    changed_pixels += 1
+            self._cursor_capture_ready = changed_pixels >= 64
+            self._cursor_capture_evidence = {
+                "method": "x11_stable_overlay_delta",
+                "changed_pixels": changed_pixels,
+                "unstable_pixels": unstable_pixels,
+                "minimum_changed_pixels": 64,
+                "bounds": {
+                    "left": left,
+                    "top": top,
+                    "right": right,
+                    "bottom": bottom,
+                },
+            }
+            if not self._cursor_capture_ready:
+                raise RuntimeError(
+                    "CUA's overlay window did not change stable captured desktop pixels"
+                )
+            return await self.get_agent_cursor_state()
+        except Exception as error:
+            self._cursor_capture_ready = False
+            return self._error(error)
