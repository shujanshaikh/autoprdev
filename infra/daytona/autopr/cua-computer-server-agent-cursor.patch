+    def _agent_cursor_overlay_window(self) -> Dict[str, Any]:
+        """Inspect the actual mapped and painted CUA X11 overlay window."""
+
+        if self._mode != "daemon":
+            return {
+                "mapped": False,
+                "painted": False,
+                "reason": "The embedded CUA runtime does not own an overlay UI runloop.",
+            }
+        connection = None
+        try:
+            from Xlib import X, display
+            from Xlib.ext import shape
+
+            connection = display.Display()
+            for window in connection.screen().root.query_tree().children:
+                title = window.get_wm_name()
+                if title != f"Cua.AgentCursorOverlay.{self._session_id}":
+                    continue
+                attributes = window.get_attributes()
+                rectangles = window.shape_get_rectangles(shape.SK.Bounding).rectangles
+                mapped = attributes.map_state == X.IsViewable
+                return {
+                    "mapped": mapped,
+                    "painted": mapped and len(rectangles) > 0,
+                    "title": title,
+                    "bounding_rectangles": len(rectangles),
+                }
+            return {
+                "mapped": False,
+                "painted": False,
+                "reason": "CUA's X11 overlay window was not found.",
+            }
+        except Exception as error:
+            return {"mapped": False, "painted": False, "error": str(error)}
+        finally:
+            if connection is not None:
+                connection.close()
+
+    async def _sync_agent_cursor_position(
