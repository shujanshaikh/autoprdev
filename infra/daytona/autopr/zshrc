# AutoPR Daytona terminal profile.

export SHELL="/usr/bin/zsh"
export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
export STARSHIP_CACHE="${STARSHIP_CACHE:-$HOME/.cache/starship}"
export TERM="${TERM:-xterm-256color}"
export COLORTERM="${COLORTERM:-truecolor}"
export CLICOLOR=1
export FORCE_COLOR=1

HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=10000
SAVEHIST=10000

setopt auto_cd
setopt auto_pushd
setopt complete_in_word
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt inc_append_history
setopt interactive_comments
setopt no_beep
setopt prompt_subst
setopt pushd_ignore_dups
setopt share_history
unsetopt prompt_sp

PROMPT_EOL_MARK=""
KEYTIMEOUT=1
ZLE_RPROMPT_INDENT=0

mkdir -p "${STARSHIP_CACHE}" "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

autoload -Uz colors && colors
autoload -Uz compinit
compinit -i -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

bindkey -e
zstyle ":completion:*" menu select
zstyle ":completion:*" matcher-list "m:{a-zA-Z}={A-Za-z}"
zstyle ":completion:*" list-colors "${(s.:.)LS_COLORS}"

alias gs="git status --short --branch"
alias ll="ls -lah --color=auto"
alias la="ls -A --color=auto"
alias ..="cd .."
alias ...="cd ../.."
alias work="tmux new-session -A -s autopr"

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  PROMPT="%B%F{green}➜%f%b %B%F{cyan}%1~%f%b %# "
fi

if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# >>> autopr terminal cwd >>>
# The app updates this file immediately before opening a browser terminal. Only
# move shells that started in a neutral directory so nested shells preserve the
# directory the user explicitly chose.
if [[ -o interactive ]] && [[ -r "$HOME/.config/autopr/terminal-cwd" ]]; then
  autopr_terminal_cwd="$(<"$HOME/.config/autopr/terminal-cwd")"
  if [[ -d "$autopr_terminal_cwd" ]] && [[ "$PWD" == "/" || "$PWD" == "/home" || "$PWD" == "$HOME" ]]; then
    cd -- "$autopr_terminal_cwd"
  fi
  unset autopr_terminal_cwd
fi
# <<< autopr terminal cwd <<<
