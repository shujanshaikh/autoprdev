#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=/tmp/autopr-e2b-desktop
DISPLAY_NUMBER="${DISPLAY:-:1}"
VNC_RESOLUTION="${VNC_RESOLUTION:-1920x1080}"
mkdir -p "$STATE_DIR"

pid_file() { printf '%s/%s.pid' "$STATE_DIR" "$1"; }
log_file() { printf '%s/%s.log' "$STATE_DIR" "$1"; }

is_running() {
  local file
  file="$(pid_file "$1")"
  [ -s "$file" ] && kill -0 "$(cat "$file")" 2>/dev/null
}

stop_process() {
  local name="$1" file pid
  file="$(pid_file "$name")"
  [ -s "$file" ] || return 0
  pid="$(cat "$file")"
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$file"
}

start_process() {
  local name="$1"
  shift
  is_running "$name" && return 0
  nohup "$@" >"$(log_file "$name")" 2>&1 &
  printf '%s\n' "$!" >"$(pid_file "$name")"
}

wait_for_display() {
  for _ in $(seq 1 100); do
    DISPLAY="$DISPLAY_NUMBER" xdpyinfo >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  return 1
}

start_one() {
  case "$1" in
    xvfb)
      start_process xvfb Xvfb "$DISPLAY_NUMBER" -screen 0 "${VNC_RESOLUTION}x24" -ac -nolisten tcp
      wait_for_display
      ;;
    xfce4)
      wait_for_display
      DISPLAY="$DISPLAY_NUMBER" start_process xfce4 dbus-launch --exit-with-session startxfce4
      ;;
    x11vnc)
      wait_for_display
      start_process x11vnc x11vnc -display "$DISPLAY_NUMBER" -forever -shared -nopw -rfbport 5901
      ;;
    novnc)
      start_process novnc websockify --web=/usr/share/novnc 6080 127.0.0.1:5901
      ;;
    *)
      printf 'Unknown desktop process: %s\n' "$1" >&2
      return 2
      ;;
  esac
}

start_desktop() {
  export DISPLAY="$DISPLAY_NUMBER"
  export HOME=/home/daytona
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/autopr-e2b-runtime}"
  install -d -m 0700 "$XDG_RUNTIME_DIR"
  for name in xvfb xfce4 x11vnc novnc; do start_one "$name"; done
  /opt/autopr/bin/autopr-cua-gateway >>"$(log_file cua)" 2>&1
}

stop_desktop() {
  local gateway_pid=/tmp/autopr-cua/8765-_1/gateway.pid
  if [ -s "$gateway_pid" ]; then
    kill "$(cat "$gateway_pid")" 2>/dev/null || true
    rm -f "$gateway_pid"
  fi
  for name in novnc x11vnc xfce4 xvfb; do stop_process "$name"; done
}

case "${1:-}" in
  start) start_desktop ;;
  stop) stop_desktop ;;
  status)
    for name in xvfb xfce4 x11vnc novnc; do is_running "$name" || exit 1; done
    ;;
  process-status) is_running "${2:?process name required}" ;;
  restart)
    name="${2:?process name required}"
    stop_process "$name"
    start_one "$name"
    ;;
  logs)
    file="$(log_file "${2:?process name required}")"
    [ -f "$file" ] && tail -n 200 "$file"
    ;;
  *)
    echo "usage: autopr-desktop {start|stop|status|process-status|restart|logs}" >&2
    exit 2
    ;;
esac
