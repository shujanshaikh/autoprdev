#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=/tmp/autopr-e2b-desktop
DISPLAY_NUMBER="${DISPLAY:-:1}"
VNC_RESOLUTION="${VNC_RESOLUTION:-1920x1080}"
mkdir -p "$STATE_DIR"

pid_file() { printf '%s/%s.pid' "$STATE_DIR" "$1"; }
log_file() { printf '%s/%s.log' "$STATE_DIR" "$1"; }
cua_gateway_pid_file() {
  printf '/tmp/autopr-cua/%s-%s/gateway.pid' "${CUA_PORT:-8765}" "${DISPLAY_NUMBER//:/_}"
}

is_owned_pid() {
  local pid="$1" executable="$2"
  local actual_executable expected_executable
  local -a argv=()

  kill -0 "$pid" 2>/dev/null || return 1
  actual_executable="$(readlink -f "/proc/${pid}/exe" 2>/dev/null)" || return 1
  expected_executable="$(readlink -f "$executable" 2>/dev/null)" || return 1
  [ "$actual_executable" = "$expected_executable" ] && return 0

  [ -r "/proc/${pid}/cmdline" ] && [ -r "$expected_executable" ] || return 1
  mapfile -d '' -t argv <"/proc/${pid}/cmdline"
  [ "${argv[1]:-}" = "$executable" ] || [ "${argv[1]:-}" = "$expected_executable" ]
}

is_running() {
  local file pid executable
  local -a pid_record=()
  file="$(pid_file "$1")"
  if [ -r "$file" ]; then
    mapfile -t pid_record <"$file"
  fi
  pid="${pid_record[0]:-}"
  executable="${pid_record[1]:-}"
  if [ -z "$pid" ] || [ -z "$executable" ] || ! is_owned_pid "$pid" "$executable"; then
    rm -f "$file"
    return 1
  fi
}

is_cua_gateway_running() {
  local file pid
  file="$(cua_gateway_pid_file)"
  [ -s "$file" ] || return 1
  IFS= read -r pid <"$file" || return 1
  is_owned_pid "$pid" /opt/autopr/cua-gateway/cua_gateway.py
}

stop_process() {
  local name="$1" file pid
  file="$(pid_file "$name")"
  is_running "$name" || return 0
  IFS= read -r pid <"$file"
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$file"
}

start_process() {
  local name="$1" executable
  shift
  is_running "$name" && return 0
  executable="$(command -v "$1")"
  nohup "$@" >"$(log_file "$name")" 2>&1 &
  printf '%s\n%s\n' "$!" "$executable" >"$(pid_file "$name")"
}

wait_for_display() {
  for _ in $(seq 1 100); do
    DISPLAY="$DISPLAY_NUMBER" xdpyinfo >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  return 1
}

wait_for_port() {
  local port="$1"
  for _ in $(seq 1 100); do
    nc -z -w 1 127.0.0.1 "$port" >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  return 1
}

start_one() {
  case "$1" in
    preview)
      start_process preview node /opt/autopr/preview-gateway.mjs
      wait_for_port 6090
      ;;
    xvfb)
      start_process xvfb Xvfb "$DISPLAY_NUMBER" -screen 0 "${VNC_RESOLUTION}x24" -ac -nolisten tcp
      wait_for_display
      ;;
    xfce4)
      wait_for_display
      DISPLAY="$DISPLAY_NUMBER" start_process xfce4 /opt/autopr/bin/autopr-xfce-session
      ;;
    x11vnc)
      wait_for_display
      start_process x11vnc x11vnc -display "$DISPLAY_NUMBER" -forever -shared -nopw -localhost -rfbport 5901
      ;;
    novnc)
      start_process novnc websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5901
      ;;
    *)
      printf 'Unknown desktop process: %s\n' "$1" >&2
      return 2
      ;;
  esac
}

start_desktop_services() {
  export DISPLAY="$DISPLAY_NUMBER"
  export HOME=/home/autopr
  export XDG_DATA_HOME="${XDG_DATA_HOME:-/home/autopr/.local/share}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/autopr-e2b-runtime}"
  export CUA_GATEWAY_HOST=127.0.0.1
  install -d -m 0700 "$XDG_RUNTIME_DIR"
  start_one preview
  for name in xvfb xfce4 x11vnc novnc; do start_one "$name"; done
}

start_desktop() {
  start_desktop_services
  /opt/autopr/bin/autopr-cua-gateway >>"$(log_file cua)" 2>&1
}

stop_desktop() {
  local gateway_pid
  local pid
  gateway_pid="$(cua_gateway_pid_file)"
  if [ -s "$gateway_pid" ]; then
    pid="$(cat "$gateway_pid")"
    if is_owned_pid "$pid" /opt/autopr/cua-gateway/cua_gateway.py; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$gateway_pid"
  fi
  for name in novnc x11vnc xfce4 xvfb preview; do stop_process "$name"; done
}

case "${1:-}" in
  start-core) start_desktop_services ;;
  start) start_desktop ;;
  stop) stop_desktop ;;
  status)
    for name in preview xvfb xfce4 x11vnc novnc; do is_running "$name" || exit 1; done
    is_cua_gateway_running || exit 1
    ;;
  process-status) is_running "${2:?process name required}" ;;
  restart)
    name="${2:?process name required}"
    stop_process "$name"
    start_one "$name"
    ;;
  logs)
    file="$(log_file "${2:?process name required}")"
    [ -f "$file" ] && tail -n 200 "$file"
    ;;
  *)
    echo "usage: autopr-desktop {start-core|start|stop|status|process-status|restart|logs}" >&2
    exit 2
    ;;
esac
